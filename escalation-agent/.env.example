# --- Partner list (same registry the Python triage uses) ---------------------
# Base URL of the deployed product-ops dashboard and its CRON_SECRET. The
# agent calls GET {PRODUCT_OPS_BASE_URL}/api/internal/partner-registry with
# "Authorization: Bearer {CRON_SECRET}". The sweep aborts if this fails.
PRODUCT_OPS_BASE_URL=
CRON_SECRET=

# --- Vitally (read-only: partner emails) -------------------------------------
VITALLY_ACCESS_TOKEN=
# The part before ".vitally.io" - used to build the "source" link in alerts.
VITALLY_APP_SUBDOMAIN=

# --- Model (same provider/model as the Python triage, for a fair comparison) --
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://us.api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini

# --- Slack (a NEW channel - not the Python job's SLACK_ALERT_TARGET) ----------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Channel ID (C...) the eve agent posts alerts to; invite the bot first.
SLACK_ALERT_CHANNEL_AGENT=C0C6Y1JKR34

# --- State (alerts, feedback, per-partner tracked items) ----------------------
# A Vercel Blob store dedicated to this project. Leave unset locally to use
# the .state/ directory instead.
BLOB_READ_WRITE_TOKEN=

# --- Optional ----------------------------------------------------------------
# Set to "1" to run the sweep outside the Mon-Fri 8am-6pm ET slots (local testing).
# ESCALATION_IGNORE_WINDOW=1
# Set to "1" to log alerts instead of posting to Slack.
# ESCALATION_DRY_RUN=1
