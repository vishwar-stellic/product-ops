# Linear personal API key (Settings -> API -> Personal API keys), format: lin_api_...
LINEAR_API_KEY=

# Optional: comma-separated list of team keys or names to restrict the report to,
# e.g. "PROG,PLAN,CARE,EXP,DEVX,PLAT,INT" or "Progress,Plan,Care".
# Leave unset to include every team that has cycles enabled.
SPRINT_STATUS_TEAMS=

# Required only for the dashboard's "Publish to Notion" button.
#
# Preferred path (requires Notion "workspace owner" permission): create an
# *internal* integration at https://www.notion.so/my-integrations, share the
# target Notion page with it via its "Connections" menu, and set this. Works
# identically on any host (serverless included) since it's just a static
# token - no connect/disconnect flow, no token file to persist.
NOTION_API_KEY=

# Fallback (only needed if you don't have "workspace owner" permission and
# NOTION_API_KEY above isn't set): create a *public* connection instead, set
# its redirect URI to match NOTION_OAUTH_REDIRECT_URI below, then paste its
# Client ID/Secret here. Click "Connect to Notion" in the dashboard to
# authorize it (once). Note: Notion rejects literal IP addresses (e.g.
# 127.0.0.1) in redirect URIs - use "localhost" instead, as shown below.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI configured on the Notion connection.
# NOTION_OAUTH_REDIRECT_URI=http://localhost:8008/notion/oauth/callback

# Only needed when deploying to a serverless host (e.g. Vercel), where the
# filesystem doesn't persist between requests so the on-disk dashboard cache
# (product_status/cache.py) wouldn't actually help. Add "Blob" storage to
# your Vercel project (Storage tab -> Create -> Blob) and it sets this for
# you automatically. Leave unset locally / on hosts with a real persistent
# disk - the on-disk cache is used instead. See README "Deploying".
BLOB_READ_WRITE_TOKEN=

# Optional: gate the whole app (dashboard page + every API route) behind
# Google sign-in, restricted to one email domain. Leave all three unset to
# keep the app open (no login required) - useful for local dev without
# setting up Google OAuth credentials. See product_status/auth.py's module
# docstring for full setup steps (create an OAuth Client ID at
# https://console.cloud.google.com/apis/credentials, add an authorized
# redirect URI matching GOOGLE_OAUTH_REDIRECT_URI below for every host this
# runs on).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth Client ID.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8008/auth/google/callback
# Email domain allowed to sign in (without the "@").
# ALLOWED_EMAIL_DOMAIN=stellic.com
# Any long random string, used to sign the session cookie - e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Required only for the dashboard's "Support Report" tab. Create an Access
# Token in Intercom (Settings -> Integrations -> Developer Hub -> your app ->
# Authentication, or a Personal Access Token) with read access to
# Conversations, and set it here. See product_status/intercom_client.py.
INTERCOM_ACCESS_TOKEN=
