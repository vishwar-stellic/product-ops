# Linear personal API key (Settings -> API -> Personal API keys), format: lin_api_...
LINEAR_API_KEY=

# Optional: comma-separated list of team keys or names to restrict the report to,
# e.g. "PROG,PLAN,CARE,EXP,DEVX,PLAT,INT" or "Progress,Plan,Care".
# Leave unset to include every team that has cycles enabled.
SPRINT_STATUS_TEAMS=

# Required only for the dashboard's "Publish to Notion" button.
#
# Preferred path (works without Notion "workspace owner" permission): create a
# *public* connection at https://www.notion.so/my-integrations, set its redirect
# URI to match NOTION_OAUTH_REDIRECT_URI below, then paste its Client ID/Secret
# here. Click "Connect to Notion" in the dashboard to authorize it (once).
# Note: Notion rejects literal IP addresses (e.g. 127.0.0.1) in redirect URIs -
# use "localhost" instead, as shown below.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI configured on the Notion connection.
# NOTION_OAUTH_REDIRECT_URI=http://localhost:8008/notion/oauth/callback

# Alternative (only if you have Notion "workspace owner" permission): create an
# *internal* integration instead, share the target Notion page with it via its
# "Connections" menu, and set this instead of the OAuth vars above.
NOTION_API_KEY=
